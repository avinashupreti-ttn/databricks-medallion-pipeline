                      "name": "segment_type",
                      "expression": "`segment_type`"
                    },
                    {
                      "name": "customer_count",
                      "expression": "`customer_count`"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": {
                  "fieldName": "customer_count",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Customers"
                },
                "color": {
                  "fieldName": "segment_type",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "custom-order",
                      "orderedValues": [
                        "High-Value",
                        "Repeat",
                        "One-Time",
                        "Inactive"
                      ]
                    }
                  },
                  "displayName": "Segment",
                  "legend": {
                    "hide": false
                  }
                },
                "label": {
                  "show": true
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Customer segmentation"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 7,
            "width": 3,
            "height": 5
          }
        },
        {
